{
  "name": "client-portal",
  "version": "0.1.0",
  "private": true,
  "description": "Client Portal for real estate companies running Zoho CRM: clients log in to track their deals, search available properties, and message their agent.",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "create-user": "node scripts/create-user.js",
    "mcp:check": "node scripts/zoho-mcp-check.js",
    "test": "node --test test/*.test.js"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "express": "^5.1.0"
  }
}
