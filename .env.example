# Copy to .env and fill in. Real environment variables override this file.

# ---- App ----------------------------------------------------------------------
APP_ENV=development              # production enables HSTS and refuses unsafe settings
PORT=3000
# Long random string: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
PORTAL_BRAND_NAME=Client Portal
PORTAL_CURRENCY=USD
PORTAL_LOCALE=en-US

# ---- Database -------------------------------------------------------------------
# Development default: SQLite file in data/. Production: PostgreSQL 16+.
# DATABASE_URL=postgresql+psycopg://portal_app:PASSWORD@db-host:5432/portal?sslmode=require
DATABASE_URL=

# ---- Sign-in security ---------------------------------------------------------------
AUTH_EMAIL_OTP=true              # password + 6-digit code emailed at every sign-in
SESSION_IDLE_MINUTES=30          # signed out after this long without activity
SESSION_MAX_HOURS=12             # signed out after this long regardless
REQUEST_TIMEOUT_SECONDS=30

# ---- Email (sign-in codes) ------------------------------------------------------------
# console = print to the server log (development only); smtp; zeptomail (Zoho ZeptoMail API)
MAIL_PROVIDER=console
MAIL_FROM_ADDRESS=no-reply@yourbrokerage.com
MAIL_FROM_NAME=Client Portal
# SMTP_HOST=smtp.zoho.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# ZEPTOMAIL_TOKEN=               # "Send Mail Token" from ZeptoMail (without the Zoho-enczapikey prefix)
# ZEPTOMAIL_URL=https://api.zeptomail.com/v1.1/email   # use your region's host (.eu, .in, ...)

# ---- Privacy & governance -------------------------------------------------------------------
PRIVACY_CONTACT_EMAIL=privacy@yourbrokerage.com
PRIVACY_POLICY_VERSION=2026-11-01
ACTIVITY_RETENTION_DAYS=730

# ---- Zoho CRM -------------------------------------------------------------------------------
ZOHO_MODE=mock                   # mock = built-in sample data; live = your Zoho CRM org
# Hosts for your data centre: US accounts.zoho.com / www.zohoapis.com, EU .eu, IN .in, AU .com.au
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://www.zohoapis.com
ZOHO_API_VERSION=v8
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Module / field API names: only set the ones your org changed. Full list: docs/ZOHO_FIELDS.md
# CRM_PROPERTIES_MODULE=Properties
# CRM_DEAL_STAGES=Inquiry,Viewing Scheduled,Offer Made,Negotiation,Under Contract,Closed Won,Closed Lost
# CRM_SIGNUP_LEAD_OWNER_ID=      # Zoho user id to own guest sign-up Leads
# PORTAL_REFERRAL_REWARD=Earn a $500 gift card when someone you refer closes with us.

# ---- Zoho MCP (how the AI reads the CRM) ----------------------------------------------------------
# From Zoho CRM > Setup > Developer Hub > MCP for AI Agents. Use a read-only server; the URL embeds its key.
ZOHO_MCP_URL=
# ZOHO_MCP_AUTHORIZATION=Bearer ...

# ---- AI (OpenAI) -------------------------------------------------------------------------------------
OPENAI_API_KEY=                  # leave empty to run without AI
OPENAI_MODEL=gpt-5-mini
# AI_MAX_REQUESTS_PER_HOUR=30
# AI_GUEST_MAX_REQUESTS_PER_HOUR=10
