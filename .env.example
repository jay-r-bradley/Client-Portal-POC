# Copy to .env and fill in. Every value has a sensible default except the Zoho credentials.

PORT=3000
NODE_ENV=development
# Long random string, e.g. `openssl rand -hex 32`. Required when NODE_ENV=production.
SESSION_SECRET=
SESSION_TTL_HOURS=12

# Audit trail of everything users do (JSON lines). Defaults to data/activity.jsonl.
# ACTIVITY_LOG_PATH=data/activity.jsonl

# Referral program: optional reward wording shown to clients on "Refer a Friend".
# PORTAL_REFERRAL_REWARD=Earn a $500 gift card when someone you refer closes with us.
# CRM_REFERRAL_LEAD_SOURCE=Client Referral
# CRM_REFERRAL_REFERRED_BY_FIELD=Referred_By
# CRM_REFERRAL_INTEREST_FIELD=Inquiry_Type

# White-labelling per brokerage
PORTAL_BRAND_NAME=Client Portal
PORTAL_CURRENCY=USD
PORTAL_LOCALE=en-US

# ---- AI features (OpenAI) -------------------------------------------------
# Leave OPENAI_API_KEY empty to run without AI. Keep the key server-side only.
OPENAI_API_KEY=
# Default is the low-cost "mini" tier. Any model with tool calling and
# Structured Outputs works; change it any time.
OPENAI_MODEL=gpt-5-mini
# OPENAI_BASE_URL=https://api.openai.com/v1   # or an OpenAI-compatible gateway
# AI_MAX_REQUESTS_PER_HOUR=30                 # per client, caps your OpenAI spend
# AI_CACHE_MINUTES=60                         # deal insights are reused until the deal changes
# AI_MAX_STEPS=6                              # max tool-call rounds per AI request

# ---- Zoho MCP (how the AI reads the CRM) ---------------------------------------
# From Zoho CRM > Setup > Developer Hub > MCP for AI Agents. Use a read-only
# server. The URL embeds the server key: keep it secret. Used when ZOHO_MODE=live.
# Then run `npm run mcp:check` and adjust config/zoho-mcp-tools.json.
ZOHO_MCP_URL=
# ZOHO_MCP_AUTHORIZATION=Bearer ...           # only if your MCP server needs a header
# ZOHO_MCP_TOOL_MAP=config/zoho-mcp-tools.json

# ---- Zoho CRM -------------------------------------------------------------
# mock = built-in sample data (no Zoho needed); live = real Zoho CRM org
ZOHO_MODE=mock

# Use the hosts for the org's data centre:
#   US  https://accounts.zoho.com     https://www.zohoapis.com
#   EU  https://accounts.zoho.eu      https://www.zohoapis.eu
#   IN  https://accounts.zoho.in      https://www.zohoapis.in
#   AU  https://accounts.zoho.com.au  https://www.zohoapis.com.au
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://www.zohoapis.com
ZOHO_API_VERSION=v8
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# ---- CRM module / field API names (only set the ones your org changed) ----
# CRM_PROPERTIES_MODULE=Properties
# CRM_DEAL_PROPERTY_FIELD=Property
# CRM_PROPERTY_PRICE_FIELD=Price
# CRM_PROPERTY_CITY_FIELD=City
# CRM_PROPERTY_STATUS_FIELD=Status
# CRM_PROPERTY_AVAILABLE_STATUS=Available
# Fallback pipeline order if the Stage picklist can't be read from Zoho:
# CRM_DEAL_STAGES=Inquiry,Viewing Scheduled,Offer Made,Negotiation,Under Contract,Closed Won,Closed Lost
# CRM_WON_STAGES=Closed Won
# CRM_LOST_STAGES=Closed Lost
# CRM_PORTAL_NOTE_PREFIX=[Client Portal]
# CRM_PORTAL_REPLY_PREFIX=[Portal Reply]
# See src/config.js for the full list.
